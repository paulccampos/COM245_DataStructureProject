<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="main-content" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.librarycontroller">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 40px; -fx-font-weight: bold;" text="Your Library" />
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Button onAction="#onCreatePlaylist" text="Create Playlist" />
            <TextField fx:id="searchTextField" promptText="Search in your library..." HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="sortComboBox" promptText="Sort by..." />
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="libraryGrid" spacing="20.0" />
         </content>
      </ScrollPane>
   </children>
</VBox>