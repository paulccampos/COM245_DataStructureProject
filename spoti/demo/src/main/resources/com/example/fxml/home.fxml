<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- This is now just the content for the center pane -->
<ScrollPane fitToWidth="true" fitToHeight="true" styleClass="main-content" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.homecontroller">
   <content>
      <VBox spacing="20.0">
         <children>            
            <VBox spacing="20.0" styleClass="greeting">
               <children>
                  <Label fx:id="welcomeLabel" text="Pagbati Pashnea" style="-fx-font-size: 40px;" />
               </children>
            </VBox>
            <VBox spacing="15.0" styleClass="made-for-you">
               <children>
                  <Label text="Made For You" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                  <HBox fx:id="playlistsVBox" spacing="20.0" styleClass="row" />
               </children>
            </VBox>
            <VBox spacing="15.0" styleClass="best-artists">
               <children>
                  <Label text="Best of Artists" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                  <HBox fx:id="hitsVBox" spacing="20.0" styleClass="row" />
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
