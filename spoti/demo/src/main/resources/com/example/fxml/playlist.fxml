<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.playlistcontroller" styleClass="root">
   <bottom>
      <VBox prefWidth="900.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Media Player Bar -->
            <HBox fx:id="mediaPlayerBar" alignment="CENTER_LEFT" maxHeight="Infinity" prefHeight="60.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #333;" visible="true">
               <children>
                  <Label fx:id="currentSongLabel" text="No song playing" prefWidth="200.0" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="previousButton" mnemonicParsing="false" text="⏮" onAction="#onPrevious" style="-fx-text-fill: white;" />
                  <Button fx:id="playPauseButton" mnemonicParsing="false" text="▶" onAction="#onPlayPause" style="-fx-text-fill: white;" />
                  <Button fx:id="nextButton" mnemonicParsing="false" text="⏭" onAction="#onNext" style="-fx-text-fill: white;" />
                  <ProgressBar fx:id="progressBar" prefWidth="200.0" style="-fx-accent: #1db954; -fx-control-inner-background: #555;" />
                  <Label fx:id="durationLabel" text="0:00 / 0:00" prefWidth="100.0" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                  <Button fx:id="viewQueueButton" mnemonicParsing="false" text="Queue" onAction="#onViewQueue" style="-fx-text-fill: white;" />
                  <Button fx:id="clearQueueButton" mnemonicParsing="false" text="Clear Queue" onAction="#onClearQueue" style="-fx-text-fill: white;" />
               </children>
            </HBox>
            <!-- Navigation Bar -->
            <HBox alignment="CENTER" prefHeight="60.0" prefWidth="900.0" spacing="60.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onHome" text="HOME" />
                  <Button mnemonicParsing="false" onAction="#onSearch" text="SEARCH" />
                  <Button mnemonicParsing="false" onAction="#onLibrary" text="LIBRARY" />
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
   <top>
      <HBox prefHeight="48.0" prefWidth="900.0" spacing="37.5" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="topPlaylistNameLabel" text="Playlist Name" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="false" BorderPane.alignment="CENTER" styleClass="scroll-pane">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="-1" prefWidth="-1">
               <children>
                  <ScrollPane AnchorPane.topAnchor="252.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.bottomAnchor="0.0" fitToWidth="true" fitToHeight="false" styleClass="scroll-pane">
                     <content>
                        <VBox fx:id="songsVBox" styleClass="responsive-vbox" VBox.vgrow="ALWAYS" />
                     </content>
                  </ScrollPane>
                  <Label fx:id="playlistNameLabel" AnchorPane.topAnchor="162.0" AnchorPane.leftAnchor="15.0" text="playlist name" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                  <Label fx:id="playlistDescriptionLabel" AnchorPane.topAnchor="190.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" text="playlist description" wrapText="true" />
                  <ImageView id="playlistcover" fitHeight="144.0" fitWidth="192.0" AnchorPane.topAnchor="18.0" AnchorPane.leftAnchor="358.5" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/vector-picture-icon.jpg" />
                     </image>
                  </ImageView>
                  <Button AnchorPane.topAnchor="18.0" AnchorPane.leftAnchor="21.0" mnemonicParsing="false" onAction="#onBack" text="back" />
                  <Button fx:id="addToLibraryButton" AnchorPane.topAnchor="18.0" AnchorPane.rightAnchor="21.0" mnemonicParsing="false" onAction="#onAddToLibrary" text="Add to Library" />
                  <HBox AnchorPane.topAnchor="192.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" prefHeight="45.0" spacing="45.0">
                     <children>
                        <Button fx:id="shuffleButton" mnemonicParsing="false" onAction="#onShuffle" text="shuffle" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="sortComboBox" prefWidth="150.0" promptText="Sort By">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Title" />
                                    <String fx:value="Artist" />
                                    <String fx:value="Duration" />
                                    <String fx:value="Release Date" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
        </content>
      </ScrollPane>
   </center>
</BorderPane>
