<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.LoginController" styleClass="root">
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" BorderPane.alignment="CENTER" styleClass="scroll-pane">
         <content>
            <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
               <children>
      <!-- Header -->
      <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #1a1a1a;">
         <children>
            <Label text="🎵 MusicStream" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label text="Welcome Back!" textFill="#cccccc">
               <font>
                  <Font name="System" size="16.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="30.0" />
         </VBox.margin>
      </VBox>

      <!-- Login Form -->
      <VBox spacing="20" style="-fx-background-color: #2a2a2a; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);">
         <children>
            <!-- Username Field -->
            <VBox spacing="8">
               <children>
                  <Label text="Username" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="usernameField" promptText="Enter your username" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-background-radius: 5;">
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                  </TextField>
               </children>
            </VBox>

            <!-- Password Field -->
            <VBox spacing="8">
               <children>
                  <Label text="Password" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="passwordField" promptText="Enter your password" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-background-radius: 5;">
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                  </PasswordField>
               </children>
            </VBox>

            <!-- Remember Me Checkbox -->
            <HBox alignment="CENTER_LEFT" spacing="8">
               <children>
                  <CheckBox fx:id="rememberMeCheckBox" text="Remember me" textFill="WHITE" style="-fx-text-fill: white;" />
               </children>
               <VBox.margin>
                  <Insets left="20.0" right="20.0" />
               </VBox.margin>
            </HBox>

            <!-- Login Button -->
            <Button fx:id="loginButton" text="Sign In" onAction="#handleLogin" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 14px; -fx-padding: 12 24;">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
               </VBox.margin>
            </Button>

            <!-- Sign Up Link -->
            <HBox alignment="CENTER" spacing="5">
               <children>
                  <Label text="Don't have an account?" textFill="#cccccc" />
                  <Hyperlink fx:id="signUpLink" text="Sign Up" onAction="#handleSignUp" style="-fx-text-fill: #4CAF50;" />
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" />
               </VBox.margin>
            </HBox>
         </children>
         <VBox.margin>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </VBox.margin>
      </VBox>
         </children>
      </VBox>
         </content>
      </ScrollPane>
   </center>
   <style>
      -fx-background-color: linear-gradient(to bottom, #1a1a1a 0%, #2a2a2a 100%);
   </style>
</BorderPane>
