<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.ProfileController">
   <children>
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="30.0" style="-fx-padding: 20;">
               <children>
                  <Button text="← Back" />
                  <Label style="-fx-font-size: 40px; -fx-font-weight: bold;" text="Your Profile" />
                  <VBox spacing="10.0" style="-fx-border-color: -spawtify-border-color; -fx-border-radius: 5; -fx-padding: 15;">
                     <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Account Details" />
                        <HBox spacing="10.0">
                           <children>
                              <Label style="-fx-font-weight: bold;" text="Username:" />
                              <Label fx:id="usernameLabel" text="Loading..." />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Label style="-fx-font-weight: bold;" text="Email:" />
                              <Label fx:id="emailLabel" text="Loading..." />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Label style="-fx-font-weight: bold;" text="Status:" />
                              <Label fx:id="statusLabel" text="Loading..." />
                           </children>
                        </HBox>
                        <Label fx:id="memberSinceLabel" style="-fx-font-style: italic;" text="Member since: ..." />
                        <Label fx:id="lastUpdatedLabel" style="-fx-font-style: italic;" text="Last updated: ..." />
                     </children>
                  </VBox>
                  <VBox spacing="10.0" style="-fx-border-color: -spawtify-border-color; -fx-border-radius: 5; -fx-padding: 15;">
                     <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Your Top Genres" />
                        <Label fx:id="genre1Label" text="1. ..." />
                        <Label fx:id="genre2Label" text="2. ..." />
                        <Label fx:id="genre3Label" text="3. ..." />
                     </children>
                  </VBox>
                  <VBox spacing="10.0" style="-fx-border-color: -spawtify-border-color; -fx-border-radius: 5; -fx-padding: 15;">
                     <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Change Password" />
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Current Password" />
                              <PasswordField fx:id="currentPasswordField" promptText="Enter your current password" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0">
                           <children>
                              <Label text="New Password" />
                              <PasswordField fx:id="newPasswordField" promptText="Enter a new password" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Confirm New Password" />
                              <PasswordField fx:id="confirmPasswordField" promptText="Confirm your new password" />
                           </children>
                        </VBox>
                        <Button onAction="#onChangePassword" text="Update Password" />
                     </children>
                  </VBox>
                  <Button onAction="#onLogout" prefWidth="200.0" style="-fx-background-color: #ff6b6b;" text="Logout" textFill="WHITE" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>