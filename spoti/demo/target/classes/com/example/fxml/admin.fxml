<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.AdminController" styleClass="root">
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" BorderPane.alignment="CENTER" styleClass="scroll-pane">
         <content>
            <VBox prefHeight="-1" prefWidth="-1" VBox.vgrow="ALWAYS">
         <children>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #333;" text="Admin Panel - User Management" />
            <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="900.0" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onCreateUser" text="Create User" />
                  <Button mnemonicParsing="false" onAction="#onBackToLogin" text="Back to Login" />
               </children>
            </HBox>
            <TableView fx:id="userTable" prefHeight="500.0" prefWidth="900.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="usernameColumn" prefWidth="150.0" text="Username" />
                <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email" />
                  <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="createdAtColumn" prefWidth="150.0" text="Created At" />
                  <TableColumn fx:id="updatedAtColumn" prefWidth="150.0" text="Updated At" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <VBox spacing="10.0" prefWidth="900.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="900.0" spacing="10.0">
                     <children>
                        <Label style="-fx-text-fill: #333;" text="Selected User:" />
                        <TextField fx:id="selectedUserField" editable="false" prefWidth="150.0" />
                        <Button mnemonicParsing="false" onAction="#onUpdateUser" text="Update" />
                        <Button mnemonicParsing="false" onAction="#onDeleteUser" text="Delete" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="900.0" spacing="10.0">
                     <children>
                        <Label style="-fx-text-fill: #333;" text="Username:" />
                        <TextField fx:id="usernameEditField" prefWidth="150.0" />
                        <Button mnemonicParsing="false" onAction="#onUpdateUsername" text="Update Username" />
                        <Label style="-fx-text-fill: #333;" text="Email:" />
                        <TextField fx:id="emailEditField" prefWidth="150.0" />
                        <Button mnemonicParsing="false" onAction="#onUpdateEmail" text="Update Email" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="900.0" spacing="10.0">
                     <children>
                        <Label style="-fx-text-fill: #333;" text="Status:" />
                        <TextField fx:id="statusEditField" prefWidth="150.0" />
                        <Button mnemonicParsing="false" onAction="#onUpdateStatus" text="Update Status" />
                        <Label style="-fx-text-fill: #333;" text="Password:" />
                        <TextField fx:id="passwordEditField" prefWidth="150.0" />
                        <Button mnemonicParsing="false" onAction="#onUpdatePassword" text="Update Password" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         </VBox>
      </content>
      </ScrollPane>
   </center>
</BorderPane>
