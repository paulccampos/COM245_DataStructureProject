<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.homecontroller" styleClass="root">
   <bottom>
      <VBox prefWidth="900.0" BorderPane.alignment="CENTER">
         <children>
            <HBox fx:id="mediaPlayerBar" alignment="CENTER_LEFT" maxHeight="Infinity" prefHeight="60.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #333;" visible="true">
               <children>
                  <Label fx:id="currentSongLabel" text="No song playing" prefWidth="200.0" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                  <Button fx:id="previousButton" mnemonicParsing="false" text="⏮" onAction="#onPrevious" style="-fx-text-fill: white;" />
                  <Button fx:id="playPauseButton" mnemonicParsing="false" text="▶" onAction="#onPlayPause" style="-fx-text-fill: white;" />
                  <Button fx:id="nextButton" mnemonicParsing="false" text="⏭" onAction="#onNext" style="-fx-text-fill: white;" />
                  <ProgressBar fx:id="progressBar" prefWidth="200.0" style="-fx-accent: #1db954; -fx-control-inner-background: #555;" />
                  <Label fx:id="durationLabel" text="0:00 / 0:00" prefWidth="100.0" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                  <Button fx:id="viewQueueButton" mnemonicParsing="false" text="Queue" onAction="#onViewQueue" style="-fx-text-fill: white;" />
                  <Button fx:id="clearQueueButton" mnemonicParsing="false" text="Clear" onAction="#onClearQueue" style="-fx-text-fill: white;" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="60.0" prefWidth="900.0" spacing="60.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onHome" text="HOME" />
                  <Button mnemonicParsing="false" onAction="#onSearch" text="SEARCH" />
                  <Button mnemonicParsing="false" onAction="#onLibrary" text="LIBRARY" />
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="48.0" prefWidth="900.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#onProfile" text="PROFILE" />
            <Button mnemonicParsing="false" onAction="#onSongs" text="SONGS" />
            <Button mnemonicParsing="false" onAction="#onPodcasts" text="PODCASTS" />
         </children>
      </HBox>
   </top>
   <children>
   </children>
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="false" BorderPane.alignment="CENTER" styleClass="scroll-pane">
        <content>
          <VBox spacing="20.0" styleClass="content-vbox" BorderPane.alignment="CENTER">
             <children>
                <Label fx:id="welcomeLabel" text="Welcome, [username]!" style="-fx-font-size: 24px; -fx-font-weight: bold;" textAlignment="CENTER" VBox.vgrow="NEVER" />
                <Label text="Your playlists and music collection" style="-fx-font-size: 16px; -fx-text-fill: #666;" textAlignment="CENTER" VBox.vgrow="NEVER" />

                <!-- Playlist Horizontal Layout -->
                <HBox fx:id="playlistsVBox" spacing="30.0" styleClass="responsive-hbox" VBox.vgrow="NEVER">
                   <children>
                   </children>
                </HBox>

                <!-- Top Hits Section -->
                <Label text="Top Hits" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" textAlignment="CENTER" VBox.vgrow="NEVER" />
                <HBox fx:id="hitsVBox" spacing="30.0" VBox.vgrow="NEVER">
                   <children>
                   </children>
                </HBox>
             </children>
          </VBox>
        </content>
      </ScrollPane>
   </center>
</BorderPane>
