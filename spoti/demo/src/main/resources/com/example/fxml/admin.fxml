<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="admin-panel" style="-fx-background-color: linear-gradient(to bottom, #0b52bf 23%, #094197 33%, #073274 61%, #052659 86%);" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.AdminController">
   <children>
      <VBox layoutX="14.0" layoutY="14.0" spacing="10.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Label style="-fx-text-fill: #ffffffff;" text="Admin Dashboard" styleClass="header-label">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onBackToLogin" text="Logout" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label style="-fx-text-fill: #ffffff;" text="Filter by Status:" />
                  <ComboBox fx:id="statusFilterComboBox" prefWidth="150.0" />
                  <Label style="-fx-text-fill: #ffffff;" text="Sort by:" />
                  <ComboBox fx:id="sortComboBox" prefWidth="150.0" />
               </children>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="usersVBox" spacing="5.0" />
               </content>
            </ScrollPane>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label style="-fx-text-fill: #ffffffff;" text="Selected User:" />
                  <TextField fx:id="selectedUserField" editable="false" prefWidth="200.0" />
               </children>
            </HBox>
            <VBox spacing="5.0" styleClass="form-box">
               <children>
                  <Label style="-fx-text-fill: #ffffffff;" text="Edit User Details" styleClass="sub-header-label" />
                  <HBox spacing="10.0">
                     <children>
                        <VBox>
                           <children>
                              <Label style="-fx-text-fill: #ffffffff;" text="Username" />
                              <TextField fx:id="usernameEditField" />
                           </children>
                        </VBox>
                        <VBox>
                           <children>
                              <Label style="-fx-text-fill: #ffffffff;" text="Email" />
                              <TextField fx:id="emailEditField" />
                           </children>
                        </VBox>
                        <VBox>
                           <children>
                              <Label style="-fx-text-fill: #ffffffff;" text="Status (admin/user)" />
                              <TextField fx:id="statusEditField" />
                           </children>
                        </VBox>
                        <VBox>
                           <children>
                              <Label style="-fx-text-fill: #ffffffff;" text="Password" />
                              <TextField fx:id="passwordEditField" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onUpdateUser" text="Update User" />
                        <Button mnemonicParsing="false" onAction="#onDeleteUser" styleClass="delete-button" text="Delete User" />
                        <Button mnemonicParsing="false" onAction="#onCreateUser" text="Create New User" />
                     </children>
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
