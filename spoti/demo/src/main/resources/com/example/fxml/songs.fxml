<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="main-content" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.songscontroller">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 40px; -fx-font-weight: bold;" text="All Songs" />
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <ComboBox fx:id="sortComboBox" promptText="Sort by..." />
            <ComboBox fx:id="genreComboBox" promptText="Filter by Genre..." />

            <!-- This is the section you need to add to your playlist.fxml -->
            <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
            <Button fx:id="optionsButton" text="..." style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            <!-- End of section to add -->

         </children>
      </HBox>

      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="songsVBox" spacing="5.0" />
         </content>
      </ScrollPane>
   </children>
</VBox>