<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="600.0" prefWidth="900.0" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.MainController">
   <left>
      <VBox styleClass="sidebar" prefWidth="280.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="logo" text="SPAWITFY" />
            <VBox styleClass="main-nav">
               <children>
                  <Hyperlink text="Home" onAction="#onHome" />
                  <Hyperlink onAction="#onProfile" text="Profile" />
                  <Hyperlink text="Search" onAction="#onSearch" />
                  <Hyperlink text="Songs" onAction="#onSongs" />
                  <Hyperlink text="Your Library" onAction="#onLibrary" />
               </children>
            </VBox>
            <VBox styleClass="playlists">
               <children>
                  <HBox styleClass="playlists-header">
                     <children>
                        <Label text="Playlists" />
                        <Label text="➕" />
                     </children>
                  </HBox>
                  <VBox fx:id="userPlaylistsVBox" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>
   <bottom>
      <HBox fx:id="mediaPlayerBar" styleClass="now-playing-bar" prefHeight="90.0" BorderPane.alignment="CENTER">
         <children>
            <HBox styleClass="song-info" prefWidth="300.0">
               <children>
                  <VBox styleClass="song-cover-placeholder" prefWidth="60.0" prefHeight="60.0" />
                  <VBox styleClass="song-details">
                     <children>
                        <Label fx:id="currentSongLabel" style="-fx-font-weight: bold;" text="Song Title" />
                        <Label fx:id="currentArtistLabel" text="Artist" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox alignment="CENTER" styleClass="center-player" HBox.hgrow="ALWAYS">
               <children>
                  <HBox styleClass="player-controls" spacing="20.0">
                     <children>                        
                        <Button fx:id="previousButton" text="⏮" onAction="#onPrevious" />
                        <Button fx:id="playPauseButton" text="▶" onAction="#onPlayPause" />
                        <Button fx:id="nextButton" text="⏭" onAction="#onNext" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" maxWidth="500.0" styleClass="progress-bar-container" spacing="10.0">
                     <children>
                        <Label fx:id="currentTimeLabel" text="0:00" />
                        <ProgressBar fx:id="progressBar" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Label fx:id="durationLabel" text="00:00" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <HBox alignment="CENTER_RIGHT" prefWidth="150.0" spacing="15.0" styleClass="volume-controls">
               <children>
                  <Button onAction="#onViewQueue" styleClass="media-button" text="Queue" />
               </children>
            </HBox>
         </children>
      </HBox>
   </bottom>
</BorderPane>