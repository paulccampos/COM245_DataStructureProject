<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.SignUpController" styleClass="root">
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="false" BorderPane.alignment="CENTER" styleClass="scroll-pane">
         <content>
            <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
         <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #1a1a1a; -fx-padding: 10 20 10 20;">
         <children>
            <Button fx:id="backButton" text="Back" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" />
            <VBox alignment="CENTER" spacing="5">
               <children>
                  <Label text="🎵 MusicStream" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label text="Create Your Account" textFill="#cccccc">
                     <font>
                        <Font name="System" size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
         <HBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="30.0" />
         </HBox.margin>
      </HBox>

      <!-- Sign Up Form -->
      <VBox spacing="20" style="-fx-background-color: #2a2a2a; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);">
         <children>
            <!-- Username Field -->
            <VBox spacing="8">
               <children>
                  <Label text="Username" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="usernameField" promptText="Choose a username" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-background-radius: 5;">
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                  </TextField>
               </children>
            </VBox>

            <!-- Email Field -->
            <VBox spacing="8">
               <children>
                  <Label text="Email" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="emailField" promptText="Enter your email" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-background-radius: 5;">
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                  </TextField>
               </children>
            </VBox>

            <!-- Password Field -->
            <VBox spacing="8">
               <children>
                  <Label text="Password" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="passwordField" promptText="Create a strong password" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-background-radius: 5;">
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                  </PasswordField>
               </children>
            </VBox>

            <!-- Confirm Password Field -->
            <VBox spacing="8">
               <children>
                  <Label text="Confirm Password" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-background-radius: 5;">
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                  </PasswordField>
               </children>
            </VBox>

            <!-- Password Strength Indicator -->
            <VBox spacing="5">
               <children>
                  <Label text="Password Strength:" textFill="WHITE" />
                  <ProgressBar fx:id="passwordStrengthBar" prefHeight="8" style="-fx-accent: #4CAF50;">
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                  </ProgressBar>
                  <Label fx:id="passwordStrengthLabel" textFill="#cccccc">
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>

            <!-- Sign Up Button -->
            <Button fx:id="signUpButton" text="Create Account" onAction="#handleSignUp" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 14px; -fx-padding: 12 24;" disable="true">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
               </VBox.margin>
            </Button>

            <!-- Back to Login Button -->
            <HBox alignment="CENTER" spacing="5">
               <children>
                  <Label text="Already have an account?" textFill="#cccccc" />
                  <Button fx:id="backToLoginLink" text="Sign In" onAction="#handleBackToLogin" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5;" />
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" />
               </VBox.margin>
            </HBox>
         </children>
         <VBox.margin>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </VBox.margin>
      </VBox>
         </children>
         </VBox>
      </content>
   </ScrollPane>
   </center>
   <style>
      -fx-background-color: linear-gradient(to bottom, #1a1a1a 0%, #2a2a2a 100%);
   </style>
</BorderPane>
