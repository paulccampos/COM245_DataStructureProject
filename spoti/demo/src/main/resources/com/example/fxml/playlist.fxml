<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="800.0" prefWidth="1200.0" styleClass="root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.playlistcontroller">
   <top>
      <VBox spacing="10.0" style="-fx-padding: 20;">
         <children>
            <Button onAction="#onBack" text="Back" />
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <VBox styleClass="song-cover-placeholder" prefHeight="150.0" prefWidth="150.0" />
                  <VBox>
                     <children>
                        <Label fx:id="playlistNameLabel" style="-fx-font-size: 48px; -fx-font-weight: bold;" text="Playlist Name" />
                        <Label fx:id="playlistDescriptionLabel" text="Playlist description..." />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="20.0" style="-fx-padding: 0 20 20 20;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Button fx:id="shuffleButton" onAction="#onShuffle" text="Shuffle Play" />
                  <Button fx:id="addToLibraryButton" onAction="#onAddToLibrary" text="Add to Library" />
                  <TextField fx:id="searchTextField" promptText="Search in playlist..." />
                  <ComboBox fx:id="sortComboBox" promptText="Sort by..." />
               </children>
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="songsVBox" spacing="5.0" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
</BorderPane>
