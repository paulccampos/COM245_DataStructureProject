<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.queuecontroller" styleClass="root">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #333;" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="currentSongLabel" text="Now Playing: ..." style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="false" BorderPane.alignment="CENTER" styleClass="scroll-pane">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="-1" prefWidth="-1">
               <children>
                  <VBox fx:id="queueVBox" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0" styleClass="responsive-vbox" VBox.vgrow="ALWAYS" />
               </children>
            </AnchorPane>
        </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="900.0" spacing="60.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#onBack" text="Back" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
